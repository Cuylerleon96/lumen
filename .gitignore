# Gradle and Android Studio
.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/

# Native engine build outputs (built in CI or by native/scripts)
native/build/
native-out/
app/src/main/jniLibs/

# Signing keys never go in the repository (CI reads the release key from secrets)
*.keystore
*.jks
build-run.log
*.log

# The published APK is an artifact, not source: it ships as a GitHub release asset, and the in-app
# updater reads the URL out of update/info.json (which IS committed). Keep only a local copy for the
# LAN update server.
update/app.apk
